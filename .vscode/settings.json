    "editor.tokenColorCustomizations": {
        "[MonoLisa Dark][__monolisa_theme_tuning_owner_v1_17cf9558__]": {
            "textMateRules": [
                {
                    "name": "MonoLisa: Theme tuning / source",
                    "scope": [
                        "source",
                        "text"
                    ],
                    "settings": {
                        "foreground": "#cce5ff"
                    }
                },
                {
                    "name": "MonoLisa: Theme tuning / comments",
                    "scope": [
                        "comment",
                        "punctuation.definition.comment"
                    ],
                    "settings": {
                        "foreground": "#7e91a6"
                    }
                },
                {
                    "name": "MonoLisa: Theme tuning / keywords",
                    "scope": [
                        "keyword",
                        "storage",
                        "storage.type"
                    ],
                    "settings": {
                        "foreground": "#e8c44a"
                    }
                },
                {
                    "name": "MonoLisa: Theme tuning / numbers",
                    "scope": [
                        "constant.numeric",
                        "constant.language",
                        "support.constant"
                    ],
                    "settings": {
                        "foreground": "#e18d5f"
                    }
                },
                {
                    "name": "MonoLisa: Theme tuning / strings",
                    "scope": [
                        "string",
                        "constant.other.symbol"
                    ],
                    "settings": {
                        "foreground": "#b8d4a0"
                    }
                },
                {
                    "name": "MonoLisa: Theme tuning / variables",
                    "scope": [
                        "variable",
                        "variable.other",
                        "support.variable"
                    ],
                    "settings": {
                        "foreground": "#e2cb7a"
                    }
                },
                {
                    "name": "MonoLisa: Theme tuning / functions",
                    "scope": [
                        "entity.name.function",
                        "support.function"
                    ],
                    "settings": {
                        "foreground": "#fff6e6"
                    }
                },
                {
                    "name": "MonoLisa: Theme tuning / types",
                    "scope": [
                        "entity.name.type",
                        "support.class",
                        "entity.name.class"
                    ],
                    "settings": {
                        "foreground": "#82b8ff"
                    }
                },
                {
                    "name": "MonoLisa: Theme tuning / tags",
                    "scope": [
                        "entity.name.tag",
                        "punctuation.definition.tag"
                    ],
                    "settings": {
                        "foreground": "#e18d5f"
                    }
                },
                {
                    "name": "MonoLisa: Theme tuning / attributes",
                    "scope": [
                        "entity.other.attribute-name"
                    ],
                    "settings": {
                        "foreground": "#82b8ff"
                    }
                },
                {
                    "name": "MonoLisa: Theme tuning / properties",
                    "scope": [
                        "variable.other.property",
                        "support.type.property-name"
                    ],
                    "settings": {
                        "foreground": "#6eb8d4"
                    }
                },
                {
                    "name": "MonoLisa: Theme tuning / operators",
                    "scope": [
                        "keyword.operator",
                        "punctuation",
                        "meta.brace"
                    ],
                    "settings": {
                        "foreground": "#c8a87a"
                    }
                },
                {
                    "name": "MonoLisa: Theme tuning / meta",
                    "scope": [
                        "meta",
                        "meta.object-literal.key"
                    ],
                    "settings": {
                        "foreground": "#9ab8d4"
                    }
                }
            ]
        }
    },
